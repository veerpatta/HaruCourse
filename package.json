{
  "name": "harucourse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build",
    "dev:cloud": "wrangler dev --port 8787",
    "db:local": "wrangler d1 migrations apply harucourse --local",
    "types": "wrangler types worker-configuration.d.ts",
    "preview": "vite preview --host 127.0.0.1",
    "check:deploy": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy",
    "test:cloud": "node scripts/test-cloud.mjs",
    "docs:generate": "node scripts/course-docs.mjs",
    "test:content": "node scripts/course-docs.mjs --check"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.129.0"
  }
}
