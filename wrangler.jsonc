{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "harucourse",
  "account_id": "39e91e2ba839bd5beb121d2453ee1d54",
  "workers_dev": true,
  "main": "server/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "harucourse",
      "database_id": "b13a76b1-5ac2-46b6-9410-caef701874b8",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "801191448b0e4a8985aa1bf6aba46962" },
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/mcp/*",
      "/authorize",
      "/oauth/*",
      "/.well-known/*",
    ],
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
